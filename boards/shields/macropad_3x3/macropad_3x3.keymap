#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    combos {
        compatible = "zmk,combos";
        combo_nav {
            timeout-ms = <50>;
            key-positions = <0 1 2>;  // top row (1 2 3)
            bindings = <&tog 1>;
        };
        combo_hotkey {
            timeout-ms = <50>;
            key-positions = <3 4 5>;  // middle row (4 5 6)
            bindings = <&tog 2>;
        };
        combo_media {
            timeout-ms = <50>;
            key-positions = <6 7 8>;  // bottom row (7 8 9)
            bindings = <&tog 3>;
        };
        combo_return {
            timeout-ms = <150>;
            key-positions = <3 4 5>;  // middle row (4 5 6)
            bindings = <&to 0>;   // return to default layer
            require-prior-idle-ms = <200>;
            global-quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -------------------
// | 1      |  2  |  3  |
// | 4      |  5  |  6  |
// | 7      |  8  |  9  |
// -------------------
            bindings = <
    &kp N1 &kp N2 &kp N3
    &kp N4 &kp N5 &kp N6
    &kp N7 &kp N8 &kp N9
            >;
        };

        };

        nav_layer {
// -----------------------
// | BTNXT |  HOME  |  PGUP  |
// | BTPRV |  END   |  PGDN  |
// | BTCLR |  _     |  _     |
// -----------------------
            bindings = <
    &bt BT_NXT &kp HOME &kp PG_UP
    &bt BT_PRV &kp END  &kp PG_DN
    &bt BT_CLR &trans   &trans
            >;
        };

        hotkey_layer {
// -----------------------------
// | Ctrl+C | Ctrl+V | Ctrl+X   |
// | Ctrl+Z | Ctrl+Y | Ctrl+S   |
// | C-S-T  | C-S-N  | Ctrl+A   |
// -----------------------------
            bindings = <
    &kp LC(C)     &kp LC(V)     &kp LC(X)
    &kp LC(Z)     &kp LC(Y)     &kp LC(S)
    &kp LC(LS(T)) &kp LC(LS(N)) &kp LC(A)
            >;
        };

        media_layer {
// -----------------------------
// | Vol Up  | Play/Pause | Vol Dn |
// | Prev    | Mute       | Next   |
// | BRI Up  | BRI Dn     | Stop   |
// -----------------------------
            bindings = <
    &kp C_VOL_UP &kp C_PP    &kp C_VOL_DN
    &kp C_PREV   &kp C_MUTE  &kp C_NEXT  
    &kp C_BRI_UP &kp C_BRI_DN &kp C_STOP
            >;
        };
    };
};